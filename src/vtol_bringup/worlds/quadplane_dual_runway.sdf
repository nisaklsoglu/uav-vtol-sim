<?xml version="1.0" ?>
<!--
  Dual QuadPlane runway world.
  Models vtol_1 / vtol_2 are prepared at launch (ports 9002 / 9012) under
  /tmp/vtol_gz_models and must appear first on GZ_SIM_RESOURCE_PATH.
-->
<sdf version="1.9">
  <world name="quadplane_dual_runway">
    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>

    <plugin name="gz::sim::systems::Physics" filename="gz-sim-physics-system" />
    <plugin name="gz::sim::systems::UserCommands" filename="gz-sim-user-commands-system" />
    <plugin name="gz::sim::systems::SceneBroadcaster" filename="gz-sim-scene-broadcaster-system" />
    <plugin name="gz::sim::systems::Imu" filename="gz-sim-imu-system" />
    <plugin name="gz::sim::systems::NavSat" filename="gz-sim-navsat-system" />
    <plugin name="gz::sim::systems::Sensors" filename="gz-sim-sensors-system">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 500 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <include>
      <uri>model://runway</uri>
      <pose>0 0 0 0 0 0</pose>
    </include>

    <spherical_coordinates>
      <surface_model>EARTH_WGS84</surface_model>
      <latitude_deg>-35.363261</latitude_deg>
      <longitude_deg>149.165230</longitude_deg>
      <elevation>584.0</elevation>
      <heading_deg>0</heading_deg>
    </spherical_coordinates>

    <!-- vtol_1: SITL -I0 / JSON 9002 / MAVROS tcp 5762 -->
    <include>
      <uri>model://vtol_1</uri>
      <name>vtol_1</name>
      <pose>0 0 0.15 0 0 0</pose>
    </include>

    <!-- vtol_2: SITL -I1 / JSON 9012 / MAVROS tcp 5772 -->
    <include>
      <uri>model://vtol_2</uri>
      <name>vtol_2</name>
      <pose>0 6.0 0.15 0 0 0</pose>
    </include>
  </world>
</sdf>
